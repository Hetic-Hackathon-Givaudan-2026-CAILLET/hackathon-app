# Copié en api/.env à la création du conteneur. Le .env n'est jamais commité.
DATABASE_URL=postgres://app:app@db:5432/app

# Ollama installé sur la machine hôte (API compatible OpenAI)
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_MODEL=llama3.2:1b
AI_API_KEY=

# Service IA de l'équipe Data/IA (ai/, port 8000) et sa clé X-API-Key
# (même valeur que API_KEY dans ai/.env, à demander aux tech-leads)
MODEL_API_URL=http://localhost:8000
MODEL_API_KEY=